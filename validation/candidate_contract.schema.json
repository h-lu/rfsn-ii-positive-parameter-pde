{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/h-lu/rfsn-ii-positive-parameter-pde/validation/candidate_contract.schema.json",
  "title": "RFSN positive-parameter candidate-validation contract",
  "description": "A frozen input description for preparing a future Issue #7 run. Conformance to this schema is not interval validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "claim_bearing",
    "theorem_target",
    "created_at",
    "source_revision",
    "theory_bindings",
    "replay_bindings",
    "parameter_domain",
    "observables",
    "obligations",
    "candidate_branches",
    "environment_lock",
    "final_status",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "rfsn-candidate-validation-contract/2"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "status": {
      "const": "DRAFT_CANDIDATE_ONLY"
    },
    "claim_bearing": {
      "const": false
    },
    "theorem_target": {
      "type": "string",
      "enum": ["B1", "B2", "V2", "V3", "V4", "V5", "V5A", "V6", "V7"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "repository_dirty",
        "reproducibility_status",
        "ignored_paths",
        "note"
      ],
      "properties": {
        "repository": {
          "const": "h-lu/rfsn-ii-positive-parameter-pde"
        },
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "repository_dirty": {
          "type": "boolean"
        },
        "reproducibility_status": {
          "type": "string",
          "enum": [
            "CLEAN_BASE_COMMIT",
            "DIRTY_BASE_COMMIT_WITH_HASH_BOUND_REPLAY_INPUTS_ONLY"
          ]
        },
        "ignored_paths": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "theory_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hashedFile"
      }
    },
    "replay_bindings": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hashedFile"
      }
    },
    "parameter_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_status", "variables"],
      "properties": {
        "selection_status": {
          "type": "string",
          "enum": [
            "EXPLORATORY_NOT_FROZEN",
            "PRESELECTED_FOR_FUTURE_VALIDATION_NOT_YET_RUN"
          ]
        },
        "variables": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/exactInterval"
          }
        },
        "selection_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definition", "normalization", "status"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "normalization": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["FIXED_DEFINITION", "DRAFT_DEFINITION"]
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "theorem_clause", "predicate", "status"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "theorem_clause": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["UNASSESSED", "CANDIDATE_READY", "BLOCKED"]
          },
          "candidate_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/hashedFile"
            }
          },
          "blocker": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate_branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch_id", "branch_type", "record", "evidence_status"],
        "allOf": [
          {
            "if": {
              "required": ["arrays"]
            },
            "then": {
              "required": ["array_prefix"]
            }
          },
          {
            "if": {
              "not": {
                "required": ["arrays"]
              }
            },
            "then": {
              "not": {
                "required": ["array_prefix"]
              }
            }
          }
        ],
        "properties": {
          "branch_id": {
            "$ref": "#/$defs/identifier"
          },
          "branch_type": {
            "type": "string",
            "enum": [
              "finite_return",
              "stable_cut",
              "pole_exit_candidate",
              "algebraic_exit_candidate",
              "lateral_exit"
            ]
          },
          "record": {
            "$ref": "#/$defs/hashedFile"
          },
          "arrays": {
            "$ref": "#/$defs/hashedFile"
          },
          "array_prefix": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_]{1,127}$"
          },
          "evidence_status": {
            "const": "COMPUTED/E1_NONRIGOROUS_CANDIDATE"
          }
        }
      }
    },
    "environment_lock": {
      "$ref": "#/$defs/hashedFile"
    },
    "final_status": {
      "const": "NOT_RUN"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{1,127}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "hashedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decimalString": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
    },
    "exactInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower_decimal", "upper_decimal", "endpoint_semantics"],
      "properties": {
        "lower_decimal": {
          "$ref": "#/$defs/decimalString"
        },
        "upper_decimal": {
          "$ref": "#/$defs/decimalString"
        },
        "endpoint_semantics": {
          "const": "exact_base10_rational"
        }
      }
    }
  }
}
