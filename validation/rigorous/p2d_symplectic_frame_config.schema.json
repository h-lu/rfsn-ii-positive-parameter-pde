      ],
      "properties": {
        "d_positive_lower": {"const": {"numerator": "2", "denominator": "3"}},
        "minus_e_positive_lower": {"const": {"numerator": "3", "denominator": "5"}},
        "kappa_lower": {"const": {"numerator": "19", "denominator": "20"}},
        "kappa_upper": {"const": {"numerator": "21", "denominator": "20"}},
        "kappa_plus_d_lower": {"const": {"numerator": "8", "denominator": "5"}},
        "half_denominator_lower": {"const": {"numerator": "17", "denominator": "10"}},
        "cos_theta_lower": {"const": {"numerator": "7", "denominator": "8"}},
        "abs_sin_theta_upper": {"const": {"numerator": "5", "denominator": "12"}},
        "radial_scale_lower": {"const": {"numerator": "19", "denominator": "20"}},
        "radial_scale_upper": {"const": {"numerator": "21", "denominator": "20"}},
        "abs_theta_upper": {"const": {"numerator": "1", "denominator": "2"}},
        "anchor_deviation_upper": {"const": {"numerator": "1", "denominator": "8"}},
        "normalized_L_D1_upper": {"const": {"numerator": "1", "denominator": "10"}},
        "normalized_L_D2_upper": {"const": {"numerator": "1", "denominator": "10"}},
        "normalized_L_inverse_D1_upper": {"const": {"numerator": "1", "denominator": "10"}},
        "normalized_L_inverse_D2_upper": {"const": {"numerator": "1", "denominator": "10"}},
        "original_L_D1_upper": {"const": {"numerator": "2", "denominator": "1"}},
        "original_L_D2_upper": {"const": {"numerator": "20", "denominator": "1"}},
        "original_L_inverse_D1_upper": {"const": {"numerator": "2", "denominator": "1"}},
        "original_L_inverse_D2_upper": {"const": {"numerator": "20", "denominator": "1"}}
      }
