{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/h-lu/rfsn-ii-positive-parameter-pde/validation/rigorous/certificate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certificate_id",
    "scope",
    "created_at",
    "source_revision",
    "source_bindings",
    "parameter_box",
    "toolchain",
    "rounding_self_test",
    "obligations",
    "integrity_status",
    "mathematical_status",
    "independent_replay",
    "final_status",
    "claim_bearing",
    "release_eligible",
    "raw_probe",
    "logs",
    "nonclaims"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "rfsn-rigorous-run-certificate/1"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "parameter_box": {
            "properties": {
              "box_id": {"const": "vdp-positive-box-v1"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "rfsn-rigorous-run-certificate/2"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "scope": {"const": "V1_V2_1_KERNEL"},
          "parameter_box": {
            "properties": {
              "path": {
                "const": "validation/rigorous/config/vdp_box_v2.json"
              },
              "box_id": {"const": "vdp-positive-box-v2"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "enum": ["V2_LOCAL_GRAPH_KERNEL", "V2_H10_C01_KERNEL", "V2_P2_JETS_KERNEL", "V2_P2_KATO_KERNEL"]
          }
        },
        "required": ["scope"]
      },
      "then": {
        "required": ["continuation_bridge", "validation_configuration"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["continuation_bridge"]},
            {"required": ["validation_configuration"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"scope": {"const": "V2_H10_C01_KERNEL"}},
        "required": ["scope"]
      },
      "then": {
        "required": [
          "h10_c01_configuration",
          "p2a_prerequisite",
          "h10_exact_center_audit"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["h10_c01_configuration"]},
            {"required": ["h10_exact_center_audit"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"scope": {"const": "V2_P2_JETS_KERNEL"}},
        "required": ["scope"]
      },
      "then": {
        "required": [
          "p2_jets_configuration",
          "p2a_prerequisite",
          "p2b0_prerequisite"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["p2_jets_configuration"]},
            {"required": ["p2b0_prerequisite"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"scope": {"const": "V2_P2_KATO_KERNEL"}},
        "required": ["scope"]
      },
      "then": {
        "required": [
          "p2_kato_configuration",
          "p2b_jets_prerequisite",
          "kato_exact_algebra_audit"
        ],
        "properties": {
          "raw_probe": {"$ref": "#/$defs/katoRawProbe"},
          "toolchain": {
            "required": ["exact_symbolic_backend"],
            "properties": {
              "exact_symbolic_backend": {
                "$ref": "#/$defs/exactSymbolicBackend"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["p2_kato_configuration"]},
            {"required": ["p2b_jets_prerequisite"]},
            {"required": ["kato_exact_algebra_audit"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "enum": ["V2_H10_C01_KERNEL", "V2_P2_JETS_KERNEL"]
          }
        },
        "required": ["scope"]
      },
      "then": {"required": ["p2a_prerequisite"]},
      "else": {"not": {"required": ["p2a_prerequisite"]}}
    }
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "rfsn-rigorous-run-certificate/1",
        "rfsn-rigorous-run-certificate/2"
      ]
    },
    "certificate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "scope": {
      "type": "string",
      "enum": ["PREFLIGHT", "V1_V2_1_KERNEL", "V2_LOCAL_GRAPH_KERNEL", "V2_H10_C01_KERNEL", "V2_P2_JETS_KERNEL", "V2_P2_KATO_KERNEL"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "repository_dirty", "allow_dirty_development", "working_tree_observation", "report_output_excluded_from_observation"],
      "properties": {
        "repository": {"const": "h-lu/rfsn-ii-positive-parameter-pde"},
        "commit": {"$ref": "#/$defs/sha1"},
        "repository_dirty": {"type": "boolean"},
        "allow_dirty_development": {"type": "boolean"},
        "working_tree_observation": {"const": "BEFORE_REPORT_WRITE"},
        "report_output_excluded_from_observation": {"const": true}
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hashedFile"}
    },
    "parameter_box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "box_id", "variables"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "box_id": {
          "enum": ["vdp-positive-box-v1", "vdp-positive-box-v2"]
        },
        "variables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["r", "a2", "epsilon"],
          "properties": {
            "r": {"$ref": "#/$defs/exactInterval"},
            "a2": {"$ref": "#/$defs/exactInterval"},
            "epsilon": {"$ref": "#/$defs/exactInterval"}
          }
        }
      }
    },
    "continuation_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bridge_id", "variables"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bridge_id": {"const": "vdp-core-to-positive-bridge-v1"},
        "variables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["r", "a2", "epsilon"],
          "properties": {
            "r": {"$ref": "#/$defs/exactInterval"},
            "a2": {"$ref": "#/$defs/exactInterval"},
            "epsilon": {"$ref": "#/$defs/exactInterval"}
          }
        }
      }
    },
    "validation_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "configuration_id"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "configuration_id": {"const": "vdp-p2-local-graph-v1"}
      }
    },
    "h10_c01_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "configuration_id"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "configuration_id": {"const": "vdp-p2-h10-c01-v1"}
      }
    },
    "p2_jets_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "configuration_id"],
      "properties": {
        "path": {"const": "validation/rigorous/config/vdp_p2_jets_v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "configuration_id": {"const": "vdp-p2-jets-v1"}
      }
    },
    "p2_kato_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "configuration_id"],
      "properties": {
        "path": {"const": "validation/rigorous/config/vdp_p2_kato_v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "configuration_id": {"const": "vdp-p2-kato-v1"}
      }
    },
    "p2a_prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_path", "configuration_sha256", "certificate_path", "certificate_sha256", "certificate_scope", "source_commit", "integrity_status", "mathematical_status", "final_status", "claim_bearing"],
      "properties": {
        "configuration_path": {"const": "validation/rigorous/config/vdp_p2_local_graph_v1.json"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_path": {"const": "validation/rigorous/results/vdp_bridge_v1_p2a_local_graph.json"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_scope": {"const": "V2_LOCAL_GRAPH_KERNEL"},
        "source_commit": {"$ref": "#/$defs/sha1"},
        "integrity_status": {"$ref": "#/$defs/verdict"},
        "mathematical_status": {"$ref": "#/$defs/verdict"},
        "final_status": {"$ref": "#/$defs/verdict"},
        "claim_bearing": {"type": "boolean"}
      }
    },
    "p2b0_prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_path", "configuration_sha256", "certificate_path", "certificate_sha256", "certificate_scope", "source_commit", "integrity_status", "mathematical_status", "final_status", "claim_bearing"],
      "properties": {
        "configuration_path": {"const": "validation/rigorous/config/vdp_p2_h10_c01_v1.json"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_path": {"const": "validation/rigorous/results/vdp_bridge_v1_p2b_h10_c01.json"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_scope": {"const": "V2_H10_C01_KERNEL"},
        "source_commit": {"$ref": "#/$defs/sha1"},
        "integrity_status": {"$ref": "#/$defs/verdict"},
        "mathematical_status": {"$ref": "#/$defs/verdict"},
        "final_status": {"$ref": "#/$defs/verdict"},
        "claim_bearing": {"type": "boolean"}
      }
    },
    "p2b_jets_prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_path", "configuration_sha256", "certificate_path", "certificate_sha256", "certificate_scope", "source_commit", "integrity_status", "mathematical_status", "final_status", "claim_bearing"],
      "properties": {
        "configuration_path": {"const": "validation/rigorous/config/vdp_p2_jets_v1.json"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_path": {"const": "validation/rigorous/results/vdp_bridge_v1_p2b_jets.json"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_scope": {"const": "V2_P2_JETS_KERNEL"},
        "source_commit": {"$ref": "#/$defs/sha1"},
        "integrity_status": {"$ref": "#/$defs/verdict"},
        "mathematical_status": {"$ref": "#/$defs/verdict"},
        "final_status": {"$ref": "#/$defs/verdict"},
        "claim_bearing": {"type": "boolean"}
      }
    },
    "kato_exact_algebra_audit": {
      "$ref": "#/$defs/katoExactAlgebraAudit"
    },
    "h10_exact_center_audit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "status", "commit", "frozen_objects", "regeneration", "term_table_audit", "failures", "inconclusive_reasons"],
      "properties": {
        "schema_version": {"const": "rfsn-vdp-h10-center-audit/1"},
        "status": {"$ref": "#/$defs/verdict"},
        "commit": {"$ref": "#/$defs/sha1"},
        "frozen_objects": {"type": "object"},
        "regeneration": {"type": "object"},
        "term_table_audit": {"type": "object"},
        "failures": {"type": "array", "items": {"type": "string"}},
        "inconclusive_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "dependency_lock_sha256", "compiler", "capd"],
      "properties": {
        "status": {"$ref": "#/$defs/verdict"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "compiler": {"type": "object"},
        "capd": {"type": "object"}
      }
    },
    "rounding_self_test": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "tests"],
      "properties": {
        "status": {"$ref": "#/$defs/verdict"},
        "tests": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"$ref": "#/$defs/verdict"}
            }
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status", "predicate"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_.]+$"},
          "status": {"$ref": "#/$defs/verdict"},
          "predicate": {"type": "string", "minLength": 1},
          "enclosures": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/hexInterval"}
          }
        }
      }
    },
    "integrity_status": {"$ref": "#/$defs/verdict"},
    "mathematical_status": {"$ref": "#/$defs/verdict"},
    "independent_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_distinct_machines", "observed_distinct_machines"],
      "properties": {
        "status": {"type": "string", "enum": ["PENDING_REQUIRED", "PASS", "FAIL"]},
        "required_distinct_machines": {"type": "integer", "minimum": 2},
        "observed_distinct_machines": {"type": "integer", "minimum": 0}
      }
    },
    "final_status": {"$ref": "#/$defs/verdict"},
    "claim_bearing": {"type": "boolean"},
    "release_eligible": {"type": "boolean"},
    "raw_probe": {
      "type": "object",
      "additionalProperties": true
    },
    "logs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "verdict": {"type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "exactSymbolicBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "sympy", "bytecode_policy", "lock_scope", "status", "errors"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "executable", "resolved_executable", "version_first_line", "sha256"],
          "properties": {
            "implementation": {"const": "cpython"},
            "executable": {"type": "string", "pattern": "^/"},
            "resolved_executable": {"type": "string", "pattern": "^/"},
            "version_first_line": {"type": "string", "pattern": "^Python [0-9]+\\.[0-9]+\\.[0-9]+"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "sympy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "package_root", "source_tree"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "package_root": {"type": "string", "pattern": "^/"},
            "source_tree": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "excluded", "sha256", "file_count"],
              "properties": {
                "algorithm": {"const": "sha256-lp64be-posix-relative-path-and-content-v1"},
                "excluded": {
                  "const": [
                    "any path with a __pycache__ component",
                    "any file whose suffix is .pyc"
                  ]
                },
                "sha256": {"$ref": "#/$defs/sha256"},
                "file_count": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "bytecode_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python_flag", "package_cache_reads"],
          "properties": {
            "python_flag": {"const": "-B"},
            "package_cache_reads": {"const": "EMPTY_ALTERNATE_PYTHONPYCACHEPREFIX"}
          }
        },
        "lock_scope": {"const": "P2_KATO_EXACT_AUDIT_ONLY"},
        "status": {"$ref": "#/$defs/verdict"},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "katoRawProbe": {"type":"object","additionalProperties":false,"required":["schema_version","status","mathematical_status","structure_status","structure_checks","rounding_self_test","grid","parameter_enclosures","acceptance_gates","normalized_true_source_jet_upper_gates","imported_p2b_physical_jet_enclosures","scalar_enclosures","normalized_parameter_jet_enclosures","original_parameter_jet_enclosures","source_coordinate_jet_enclosures","original_parameter_source_coordinate_jet_enclosures","normalized_true_source_jet_enclosures","original_parameter_true_source_jet_enclosures","riesz_transport_gate_margins","frame_change_gate_margins","c2_lift_gate_margins","source_parameterization_gate_margins","norm_contract","source_composition","external_exact_audit_contract","obligations"],"properties":{"schema_version":{"const":"rfsn-vdp-p2-kato-probe/1"},"status":{"$ref":"#/$defs/verdict"},"mathematical_status":{"$ref":"#/$defs/verdict"},"structure_status":{"$ref":"#/$defs/verdict"},"structure_checks":{"type":"object","additionalProperties":false,"required":["gap_free_exact_rational_grid","bridge_matches_parameter_normalization","subdivisions_match_frozen_contract","original_parameter_scales_match_frozen_contract","all_rational_inputs_strictly_positive","parameter_grid_nonempty","parameter_ad_hessians_bit_symmetric","complete_first_parameter_multiindices","complete_full_ordered_second_parameter_indices","second_parameter_off_diagonals_counted_twice","imported_p2b_upper_rationals_positive","imported_p2b_triangle_complete","source_triangle_complete","full_rectangular_source_not_claimed","all_sqrt_domains_uniformly_positive","physical_frame_gram_eigenvalue_enclosures_nonempty"],"properties":{"gap_free_exact_rational_grid":{"type":"boolean"},"bridge_matches_parameter_normalization":{"type":"boolean"},"subdivisions_match_frozen_contract":{"type":"boolean"},"original_parameter_scales_match_frozen_contract":{"type":"boolean"},"all_rational_inputs_strictly_positive":{"type":"boolean